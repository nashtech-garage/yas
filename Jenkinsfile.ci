def changedFiles = []
def backendServices = [
    'common-library',
    'media', 'product', 'order', 'inventory', 'payment', 'sampledata',
    'customer', 'cart', 'tax', 'search',
    'backoffice-bff', 'storefront-bff'
]
def coverageServices = [
    'media', 'product', 'order', 'inventory', 'payment', 'sampledata',
    'customer', 'cart', 'tax', 'search',
    'backoffice-bff', 'storefront-bff'
]
def dockerServices = [
    'media', 'product', 'order', 'inventory', 'payment',
    'sampledata', 'customer', 'cart', 'tax', 'search',
    'backoffice-bff', 'storefront-bff', 'backoffice', 'storefront'
]

pipeline {
    agent { label 'gcp-k8s-agent' }

    stages {
        stage('Pre-check') {
            steps {
                script {
                    echo "Checking environment..."
                    sh 'java -version'
                    sh 'mvn -version'
                    sh 'gitleaks version'
                    sh 'snyk --version'
                }
            }
        }

        stage('Check Skip') {
            steps {
                script {
                    sh 'git fetch origin main:refs/remotes/origin/main || true'

                    def changedFilesOutput = sh(script: '''
                        MERGE_BASE=$(git merge-base origin/main HEAD 2>/dev/null || true)
                        HEAD_SHA=$(git rev-parse HEAD)
                        if [ -z "${MERGE_BASE}" ]; then
                            git diff --name-only HEAD~1 HEAD 2>/dev/null || true
                        elif [ "${MERGE_BASE}" = "${HEAD_SHA}" ]; then
                            if [ "$(git rev-list --count HEAD 2>/dev/null || echo 0)" -ge 2 ]; then
                                git diff --name-only HEAD~1 HEAD
                            fi
                        else
                            git diff --name-only "${MERGE_BASE}" HEAD
                        fi
                    ''', returnStdout: true).trim()
                    changedFiles = changedFilesOutput ? changedFilesOutput.split('\n') : []
                    echo "Changed files in PR: ${changedFiles.join(', ')}"

                    // Resolve branch name (Multibranch sets BRANCH_NAME, fallback to GIT_BRANCH)
                    def branchName = (env.BRANCH_NAME ?: env.GIT_BRANCH ?: '')
                        .replaceFirst('^refs/remotes/origin/', '')
                        .replaceFirst('^refs/heads/', '')
                        .replaceFirst('^origin/', '')
                        .replaceFirst('^\\*/', '')
                    env.BRANCH_IS_MAIN = (branchName == 'main') ? 'true' : 'false'
                    echo "Branch: ${branchName} — BRANCH_IS_MAIN=${env.BRANCH_IS_MAIN}"

                    // Resolve git tag at HEAD (safe: inside node/steps context)
                    def gitTag = sh(script: '''
                        git tag --points-at HEAD 2>/dev/null \
                            | grep -E '^v[0-9]+\\.[0-9]+\\.[0-9]+' \
                            | head -n 1 || true
                    ''', returnStdout: true).trim()
                    env.GIT_TAG_MATCH = gitTag ? 'true' : 'false'
                    env.GIT_TAG_NAME  = gitTag
                    echo "Git tag at HEAD: '${gitTag}' — GIT_TAG_MATCH=${env.GIT_TAG_MATCH}"

                    def globalImpact = changedFiles.any {
                        it == 'pom.xml' ||
                        it == 'mvnw' ||
                        it == 'mvnw.cmd' ||
                        it.startsWith('.mvn/') ||
                        it.startsWith('common-library/')
                    }
                    env.GLOBAL_IMPACT = globalImpact ? 'true' : 'false'
                    echo "GLOBAL_IMPACT=${env.GLOBAL_IMPACT}"

                    env.DOCS_ONLY = changedFiles.every { it.startsWith('docs/') || it.endsWith('.md') || it.endsWith('.pdf') || it == 'Jenkinsfile' || it == 'Jenkinsfile.ci' } ? 'true' : 'false'
                    if (env.GIT_TAG_MATCH == 'true') {
                        env.DOCS_ONLY = 'false'
                        echo "Release tag detected — forcing CI/CD stages for staging."
                    }
                    if (env.DOCS_ONLY == 'true') {
                        echo "Only documentation/CI files changed — skipping CI stages."
                    } else {
                        echo "Code changes detected — running full pipeline."
                    }
                }
            }
        }

        stage('Secret Scanning') {
            when { expression { env.DOCS_ONLY == 'false' } }
            steps {
                script {
                    sh 'git fetch origin main:refs/remotes/origin/main || true'
                    def mergeBase = sh(script: 'git merge-base origin/main HEAD 2>/dev/null || git rev-parse HEAD~1', returnStdout: true).trim()
                    def logOpts = (env.BRANCH_IS_MAIN == 'true') ? 'HEAD~1..HEAD' : "${mergeBase}..HEAD"
                    echo "Secret scan git range: ${logOpts}"
                    sh """
                        gitleaks detect --source . \
                            --config gitleaks.toml \
                            --log-opts "${logOpts}" \
                            --report-format json \
                            --report-path gitleaks-report.json \
                            --exit-code 1
                    """
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'gitleaks-report.json',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('Monorepo Execution') {
            when { expression { env.DOCS_ONLY == 'false' } }
            steps {
                script {
                    for (service in backendServices) {
                        if (env.GIT_TAG_MATCH == 'true' || env.GLOBAL_IMPACT == 'true' || changedFiles.any { it.startsWith("${service}/") }) {
                            echo "Processing service: ${service}"
                            sh "mvn test -pl ${service} -am"
                            junit testResults: "${service}/target/surefire-reports/*.xml", allowEmptyResults: true
                            sh "mvn package -DskipTests -pl ${service} -am"
                        } else {
                            echo "${service} no change, skip."
                        }
                    }
                }
            }
        }

        stage('Code Quality') {
            when { expression { env.DOCS_ONLY == 'false' } }
            steps {
                script {
                    withSonarQubeEnv('SonarQube') {
                        def exitCode = sh(
                            script: 'mvn sonar:sonar -Dsonar.projectKey=yas -Dsonar.java.binaries=.',
                            returnStatus: true
                        )
                        if (exitCode != 0) {
                            env.SONAR_SKIPPED = 'true'
                            echo "WARNING: SonarQube analysis failed or is unavailable (exit ${exitCode}) — continuing CD stages."
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            when {
                allOf {
                    expression { env.DOCS_ONLY == 'false' }
                    expression { env.SONAR_SKIPPED != 'true' }
                }
            }
            steps {
                script {
                    // waitForQualityGate requires SonarQube context to read task ID
                    withSonarQubeEnv('SonarQube') {
                        try {
                            timeout(time: 5, unit: 'MINUTES') {
                                def qualityGate = waitForQualityGate abortPipeline: false
                                env.SONAR_QG_STATUS = qualityGate.status
                                if (qualityGate.status != 'OK') {
                                    echo "WARNING: Quality Gate is '${qualityGate.status}' — continuing CD stages."
                                }
                            }
                        } catch (Exception e) {
                            env.SONAR_SKIPPED = 'true'
                            echo "WARNING: Quality Gate check failed — ${e.message}. Continuing CD stages."
                        }
                    }
                }
            }
        }

        stage('Coverage Report') {
            when { expression { env.DOCS_ONLY == 'false' } }
            steps {
                script {
                    for (service in coverageServices) {
                        if (env.GIT_TAG_MATCH == 'true' || env.GLOBAL_IMPACT == 'true' || changedFiles.any { it.startsWith("${service}/") }) {
                            echo "Publishing JaCoCo report for: ${service}"
                            jacoco(
                                execPattern: "${service}/target/jacoco.exec",
                                classPattern: "${service}/target/classes",
                                sourcePattern: "${service}/src/main/java",
                                exclusionPattern: '**/config/**,**/exception/**,**/constants/**,**/*Application.class',
                                minimumInstructionCoverage: '70',
                                minimumBranchCoverage: '0',
                                changeBuildStatus: true
                            )
                            if (currentBuild.result == 'UNSTABLE' || currentBuild.result == 'FAILURE') {
                                error("Coverage gate FAILED for ${service}: Instruction coverage is below 70%!")
                            }
                        }
                    }
                }
            }
        }

        stage('Dependency Scan') {
            when { expression { env.DOCS_ONLY == 'false' } }
            steps {
                withCredentials([string(credentialsId: 'snyk-token', variable: 'SNYK_TOKEN')]) {
                    sh 'snyk auth $SNYK_TOKEN'
                    sh 'snyk test --all-projects --json > snyk-report.json || true'
                    sh 'snyk monitor --all-projects || true'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'snyk-report.json',
                                     allowEmptyArchive: true
                }
            }
        }

        // =====================================================================
        // STAGES MỚI: Docker Build & Push + GitOps Update
        // =====================================================================

        stage('Docker Build & Push') {
            when { expression { env.DOCS_ONLY == 'false' } }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-cred',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    script {
                        def commitId = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()

                        sh "docker login -u ${DOCKER_USER} -p ${DOCKER_PASS}"

                        def servicePaths = [
                            'swagger-ui': 'k8s/charts/swagger-ui'
                        ]
                        def buildAllImages = (env.GIT_TAG_MATCH == 'true' || env.GLOBAL_IMPACT == 'true')

                        for (service in dockerServices) {
                            def servicePath = servicePaths.get(service, service)
                            if (buildAllImages || changedFiles.any { it.startsWith("${servicePath}/") }) {
                                if (!fileExists("${servicePath}/Dockerfile")) {
                                    echo "${service}: no Dockerfile at ${servicePath}; skip Docker build"
                                    continue
                                }
                                echo "Building Docker image for: ${service}"
                                sh "docker build -t bingsu1103/${service}:${commitId} ./${servicePath}/"
                                sh "docker push bingsu1103/${service}:${commitId}"

                                if (env.BRANCH_IS_MAIN == 'true') {
                                    sh "docker tag bingsu1103/${service}:${commitId} bingsu1103/${service}:latest"
                                    sh "docker push bingsu1103/${service}:latest"
                                }

                                if (env.GIT_TAG_MATCH == 'true') {
                                    sh "docker tag bingsu1103/${service}:${commitId} bingsu1103/${service}:${env.GIT_TAG_NAME}"
                                    sh "docker push bingsu1103/${service}:${env.GIT_TAG_NAME}"
                                }

                                echo "${service}:${commitId} pushed to Docker Hub"
                            } else {
                                echo "${service}: no changes, skip build"
                            }
                        }
                    }
                }
            }
        }

        stage('Update GitOps — Dev') {
            when {
                allOf {
                    expression { env.DOCS_ONLY == 'false' }
                    expression { env.BRANCH_IS_MAIN == 'true' }
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-pat', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
                    sh 'bash scripts/update-gitops-manifest.sh dev'
                }
            }
        }

        stage('Update GitOps — Staging') {
            when {
                allOf {
                    expression { env.DOCS_ONLY == 'false' }
                    expression { env.GIT_TAG_MATCH == 'true' }
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-pat', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
                    sh "bash scripts/update-gitops-manifest.sh staging '${env.GIT_TAG_NAME}'"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline Succeeded"
        }
        failure {
            echo "Pipeline Failed — Coverage may be below 70% or build error occurred."
        }
        always {
            cleanWs()
        }
    }
}
