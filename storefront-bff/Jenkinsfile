pipeline {
    agent any

    tools {
        maven 'Maven'   // phải config trong Jenkins Global Tool
        jdk 'JDK11'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                dir('storefront-bff') {
                    sh 'mvn clean test'
                }
            }
            post {
                always {
                    // Upload test result
                    junit 'storefront-bff/target/surefire-reports/*.xml'

                    // Upload coverage (JaCoCo)
                    publishCoverage adapters: [
                        jacocoAdapter('media-service/target/site/jacoco/jacoco.xml')
                    ]
                }
            }
        }

        stage('Build') {
            steps {
                dir('storefront-bff') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }
    }
}
