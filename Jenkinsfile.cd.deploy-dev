pipeline {
    agent any
    environment {
        DOCKER_USER = 'lebaoo12'
        KUBECONFIG_ID = 'k8s-kubeconfig'
    }
    stages {
        stage('Deploy main to Dev Namespace') {
            steps {
                withCredentials([file(credentialsId: "${KUBECONFIG_ID}", variable: 'KUBECONFIG')]) {
                    script {
                        def serviceMap = [
                            'product': 'product', 'media': 'media', 'customer': 'customer',
                            'cart': 'cart', 'tax': 'tax', 'order': 'order',
                            'inventory': 'inventory', 'search': 'search',
                            'storefront-bff': 'storefront-bff', 'storefront-ui': 'storefront',
                            'backoffice-bff': 'backoffice-bff', 'backoffice-ui': 'backoffice'
                        ]
                        
                        echo "🚀 Tự động deploy đè nhánh main vào namespace DEV..."
                        serviceMap.each { deploymentName, imageName ->
                            sh "KUBECONFIG=\$KUBECONFIG kubectl set image deployment/${deploymentName} ${deploymentName}=${DOCKER_USER}/yas-${imageName}:main -n dev"
                        }
                    }
                }
            }
        }
    }
}
